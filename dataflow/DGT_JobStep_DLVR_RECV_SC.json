{
	"name": "DGT_JobStep_DLVR_RECV_SC",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				},
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "xpsEC"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "window1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "AlterRow1"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "join1"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ecEventGkey as long,",
				"          yardGkey as integer,",
				"          YardID as string,",
				"          FcyID as string,",
				"          cheKind as string,",
				"          CHE_Name as string,",
				"          eventType as short,",
				"          eventSubType as short,",
				"          eventTypeDescription as string,",
				"          fromCheIdName as integer,",
				"          ToCheIdName as integer,",
				"          unit as string,",
				"          pow as string,",
				"          pool as string,",
				"          workQueue as string,",
				"          travelDistance as integer,",
				"          moveKind as string,",
				"          isTwin as boolean,",
				"          startDistance as integer,",
				"          workAssignment as long,",
				"          unitRef as string,",
				"          tran_ID as string,",
				"          locType as string,",
				"          locID as string,",
				"          locSlot as string,",
				"          opsPosID as string,",
				"          unladenLoctype as string,",
				"          unladenLocID as string,",
				"          unladenLocSlot as string,",
				"          ladenLoctype as string,",
				"          ladenLocID as string,",
				"          laden_LocSlot as string,",
				"          EcEventTime as timestamp,",
				"          cheID as integer,",
				"          Year as integer,",
				"          Month as integer,",
				"          Week as integer,",
				"          OPERATOR_ID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'silver/ecevents') ~> source1",
				"source(output(",
				"          gkey as string,",
				"          user_id as string,",
				"          name as string,",
				"          yard as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'bronze/xpsecuser',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> xpsEC",
				"select2 filter(not(isNull(ecEventGkey)) && cheKind==\"SC\" && (eventTypeDescription==\"EAGD\" || eventTypeDescription==\"LTRW\" || eventTypeDescription==\"LARW\" || eventTypeDescription==\"EARW\" || eventTypeDescription==\"LTGD\" || eventTypeDescription==\"LAGD\" ) && (moveKind==\"RECV\"||moveKind==\"DLVR\")) ~> filter1",
				"filter1 window(over(cheID),",
				"     asc(EcEventTime, true),",
				"     asc(ecEventGkey, true),",
				"     eventTypeDescription_nxt = lead(eventTypeDescription),",
				"          eventTypeDescription_lag = lag(eventTypeDescription)) ~> window1",
				"window1 derive(jobStep = iif(eventTypeDescription == 'LTGD',\r",
				"    iif(eventTypeDescription_nxt == 'LAGD' && eventTypeDescription_lag == 'EARW', 1, 0),\r",
				"    iif(eventTypeDescription == 'LTRW',\r",
				"        iif(eventTypeDescription_nxt == 'LARW' && eventTypeDescription_lag == 'EAGD', 1, 0),\r",
				"        toInteger(null())\r",
				"    )\r",
				"),",
				"          Types = case(\r",
				"    eventTypeDescription == 'LTGD', \r",
				"        iif((eventTypeDescription_nxt != 'LAGD' || isNull(eventTypeDescription_nxt)) && (eventTypeDescription_lag != 'EARW' || isNull(eventTypeDescription_lag)), 'Miss at Row and Grid',\r",
				"        iif(eventTypeDescription_nxt != 'LAGD' || isNull(eventTypeDescription_nxt), 'DLVR-Miss Arrive at Grid',\r",
				"        iif(eventTypeDescription_lag != 'EARW' || isNull(eventTypeDescription_lag), 'DLVR-Miss Arrive at Row', 'No Violation'))),\r",
				"    \r",
				"    eventTypeDescription == 'LTRW', \r",
				"        iif((eventTypeDescription_nxt != 'LARW' || isNull(eventTypeDescription_nxt)) && (eventTypeDescription_lag != 'EAGD' || isNull(eventTypeDescription_lag)), 'Miss at Row and Grid',\r",
				"        iif(eventTypeDescription_nxt != 'LARW' || isNull(eventTypeDescription_nxt), 'RECV-Miss Arrive at Row',\r",
				"        iif(eventTypeDescription_lag != 'EAGD' || isNull(eventTypeDescription_lag), 'RECV-Miss Arrive at Grid', 'No Violation'))),\r",
				"    \r",
				"    toString(null())\r",
				"),",
				"          operatorName = regexReplace(OPERATOR_ID, `[^a-zA-Z0-9]`, '')) ~> derivedColumn1",
				"select4 alterRow(upsertIf(true())) ~> AlterRow1",
				"derivedColumn1 select(mapColumn(",
				"          ecEventGkey,",
				"          yardGkey,",
				"          YardID,",
				"          FcyID,",
				"          cheKind,",
				"          CHE_Name,",
				"          eventType,",
				"          eventSubType,",
				"          eventTypeDescription,",
				"          unit,",
				"          pow,",
				"          pool,",
				"          travelDistance,",
				"          moveKind,",
				"          startDistance,",
				"          EcEventTime,",
				"          cheID,",
				"          Year,",
				"          Month,",
				"          Week,",
				"          OperatorID = operatorName,",
				"          eventTypeDescription_lag,",
				"          eventTypeDescription_nxt,",
				"          jobStep,",
				"          Types",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source1 select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xpsEC select(mapColumn(",
				"          gkey,",
				"          user_id,",
				"          name,",
				"          yard",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 aggregate(groupBy(user_id),",
				"     each(match(name!='user_id'), $$ = last($$))) ~> aggregate1",
				"aggregate1 filter(not(isNull(user_id))) ~> filter2",
				"select1, filter2 join(OperatorID == user_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ecEventGkey,",
				"          yardGkey,",
				"          YardID,",
				"          FcyID,",
				"          cheKind,",
				"          CHE_Name,",
				"          eventType,",
				"          eventSubType,",
				"          eventTypeDescription,",
				"          unit,",
				"          pow,",
				"          pool,",
				"          travelDistance,",
				"          moveKind,",
				"          startDistance,",
				"          EcEventTime,",
				"          cheID,",
				"          Year,",
				"          Month,",
				"          Week,",
				"          OperatorID,",
				"          eventTypeDescription_lag,",
				"          eventTypeDescription_nxt,",
				"          jobStep,",
				"          Types,",
				"          user_id,",
				"          gkey,",
				"          name,",
				"          yard",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'gold/jobstep_missed_2',",
				"     mergeSchema: true,",
				"     autoCompact: true,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['ecEventGkey'],",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}