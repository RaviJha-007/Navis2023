{
	"name": "DGT_SC",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Handler id} as string,",
				"          Pool as string,",
				"          RDT2 as string,",
				"          Job as string,",
				"          Allow as string,",
				"          {Max TEU} as string,",
				"          {Max Wt} as string,",
				"          Scale as string,",
				"          RDT8 as string,",
				"          PrgN as string,",
				"          Screen as string,",
				"          {Screen Wh} as string,",
				"          {Screen Ht} as string,",
				"          {PDS Wgt} as string,",
				"          PDS as string,",
				"          {Num F-Keys} as string,",
				"          Login as string,",
				"          Prog as string,",
				"          {Op Mode} as string,",
				"          Dec as string,",
				"          {Long Name} as string,",
				"          Height as string,",
				"          {Twin Diff Wgt Allowance} as string,",
				"          {Comm Index} as string,",
				"          Hex as string,",
				"          TAIT as string,",
				"          Width as string,",
				"          {Reach Left} as string,",
				"          {Reach Right} as string,",
				"          {Twin Lift Capable} as string,",
				"          {Twin Carry Cap} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'bronze/SC_Info',",
				"     columnDelimiter: '\\t',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> source1",
				"source1 select(mapColumn(",
				"          {Handler id},",
				"          Pool,",
				"          RDT2,",
				"          Job,",
				"          Allow,",
				"          {Max TEU},",
				"          {Max Wt},",
				"          Scale,",
				"          RDT8,",
				"          PrgN,",
				"          Screen,",
				"          {Screen Wh},",
				"          {Screen Ht},",
				"          {PDS Wgt},",
				"          PDS,",
				"          {Num F-Keys},",
				"          Login,",
				"          Prog,",
				"          {Op Mode},",
				"          Dec,",
				"          {Long Name},",
				"          Height,",
				"          {Twin Diff Wgt Allowance},",
				"          {Comm Index},",
				"          Hex,",
				"          TAIT,",
				"          Width,",
				"          {Reach Left},",
				"          {Reach Right},",
				"          {Twin Lift Capable},",
				"          {Twin Carry Cap}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select2 alterRow(upsertIf(true())) ~> alterRow1",
				"select1 select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'gold/SC_info',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}