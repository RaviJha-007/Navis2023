{
	"name": "DGT_UnitStatus",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "unitstatus"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "window1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "window2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "select2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Container_Nbr as string,",
				"          Time_Of_event as timestamp,",
				"          Event as string,",
				"          From_Position as string,",
				"          To_Position as string,",
				"          Current_POD as string,",
				"          Outbound_Carrier as string,",
				"          Carrier_Service as string,",
				"          Eq_Class as string,",
				"          time_out as timestamp,",
				"          Eq_Length as string,",
				"          Status as string,",
				"          Cycle_Status as string,",
				"          Date_Of_Event as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/unit_position_correction/load','bronze/unit_position_correction/archive'],",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'silver/unit_position_corrections') ~> unitstatus",
				"sort1 window(over(Container_Nbr),",
				"     asc(Time_Of_event, true),",
				"     Previous_Cycle_Status = lag(Cycle_Status, 1),",
				"          Previous_Time_Of_event = lag(Time_Of_event,1)) ~> window1",
				"filter1 sort(asc(Time_Of_event, true)) ~> sort1",
				"unitstatus filter(Cycle_Status!=\"\") ~> filter1",
				"window1 derive(Cycle_Start_Flag = iif((Cycle_Status == \"START\"), 1, 0)) ~> derivedColumn2",
				"derivedColumn2 window(over(Container_Nbr),",
				"     asc(Time_Of_event, true),",
				"     Cycle_ID = sum(Cycle_Start_Flag)) ~> window2",
				"aggregate1 derive(Cycle_Flag = iif(\r",
				"    isNull(Cycle_ID) || Cycle_ID == 0,\r",
				"    \"Unable to Validate\",\r",
				"    iif(\r",
				"        Cycle_Has_End == 0,\r",
				"        \"Open Cycle\",\r",
				"        iif(\r",
				"            Cycle_Has_Correction == 1,\r",
				"            \"Yes\",\r",
				"            \"No\"\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn3",
				"join1 derive(Valid_Correction_Flag = iif(\r",
				"    Cycle_Flag == \"Yes\"\r",
				"    && Cycle_Status == \"CORRECTION\",\r",
				"    1,\r",
				"    0\r",
				"),",
				"          Correction_Type = iif(\r",
				"    (Cycle_Flag == \"Yes\"\r",
				"    && Cycle_Status == \"CORRECTION\"),\r",
				"(iif(substring(:From_Pos, 1, 3) != substring(:To_Pos, 1, 3), \"Block_To_Block\", iif( not((substring(:From_Pos, 1, 3) == substring(:To_Pos, 1, 3)) && (substring(:From_Pos, 5, 2) == substring(:To_Pos, 5, 2))), \"Same_Block_Correction\", iif(substring(:From_Pos, 1, 6) != substring(:To_Pos, 1, 6), \"Stack_Correction\", toString(null()))))),\r",
				"toString(null())),",
				"          From_Pos := iif(length(split(From_Position, \"-\")[3]) == 8, substring(split(From_Position, \"-\")[3], 0, 7), split(From_Position, \"-\")[3]),",
				"          To_Pos := iif(length(split(To_Position, \"-\")[3]) == 8, substring(split(To_Position, \"-\")[3], 0, 7), split(To_Position, \"-\")[3])) ~> derivedColumn4",
				"derivedColumn4 select(mapColumn(",
				"          Container_Nbr = unitstatus@Container_Nbr,",
				"          Event,",
				"          From_Position,",
				"          To_Position,",
				"          Current_POD,",
				"          Outbound_Carrier,",
				"          Carrier_Service,",
				"          Eq_Class,",
				"          time_out,",
				"          Eq_Length,",
				"          Time_Of_event,",
				"          Status,",
				"          Cycle_Status,",
				"          Date_Of_Event,",
				"          Previous_Cycle_Status,",
				"          Previous_Time_Of_event,",
				"          Cycle_Start_Flag,",
				"          Cycle_ID = window2@Cycle_ID,",
				"          Cycle_Has_End,",
				"          Cycle_Has_Correction,",
				"          Cycle_Flag,",
				"          Valid_Correction_Flag,",
				"          Correction_Type",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"window2 aggregate(groupBy(Container_Nbr,",
				"          Cycle_ID),",
				"     Cycle_Has_End = max(iif(Cycle_Status==\"END\", 1, 0)),",
				"          Cycle_Has_Correction = max(iif(Cycle_Status == \"CORRECTION\", 1, 0))) ~> aggregate1",
				"window2, derivedColumn3 join(unitstatus@Container_Nbr == aggregate1@Container_Nbr",
				"     && window2@Cycle_ID == aggregate1@Cycle_ID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'gold/unit_correction_status',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}