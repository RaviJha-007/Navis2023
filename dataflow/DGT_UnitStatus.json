{
	"name": "DGT_UnitStatus",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "unitstatus"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "window1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "window2"
				},
				{
					"name": "window3"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Container Nbr} as string,",
				"          Event as string,",
				"          {From Position} as string,",
				"          {To Position} as string,",
				"          {Current POD} as string,",
				"          {Outbound Carrier} as string,",
				"          {Carrier Service} as string,",
				"          {Eq Class} as string,",
				"          time_out as string,",
				"          {Eq Length} as string,",
				"          Time_Of_event as string,",
				"          Status as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/unitstatus/load','bronze/unitstatus/archive'],",
				"     format: 'delimited',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'bronze/unitstatus/load',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> unitstatus",
				"unitstatus select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive({Container Nbr} = trim(Container_Nbr),",
				"          Time_Of_event = toTimestamp(Time_Of_event, 'yyyy-MM-dd HH:mm:ss'),",
				"          Event = upper(Event),",
				"          time_out = toTimestamp(time_out, 'yyyy-MM-dd HH:mm:ss'),",
				"          Cycle_Status = iif((upper(Event)==\"UNIT_RECEIVE\" || upper(Event)==\"UNIT_DISCH\"), \"START\", iif((upper(Event)==\"UNIT_POSITION_CORRECTION\"), \"CORRECTION\", iif((upper(Event)==\"UNIT_LOAD\" || upper(Event)==\"UNIT_DELIVER\"), \"END\",\"\"))),",
				"          Date_Of_Event = toDate(Time_Of_event, 'yyyy-MM-dd')) ~> derivedColumn1",
				"sort1 window(over(Date_Of_Event,",
				"          Container_Nbr),",
				"     asc(Time_Of_event, true),",
				"     Previous_Cycle_Status = lag(Cycle_Status, 1),",
				"          Previous_Time_Of_event = lag(Time_Of_event,1)) ~> window1",
				"filter1 sort(asc(Time_Of_event, true)) ~> sort1",
				"derivedColumn1 filter(Cycle_Status!=\"\") ~> filter1",
				"window1 derive(Cycle_Start_Flag = iif((Cycle_Status == \"START\"), 1, 0)) ~> derivedColumn2",
				"derivedColumn2 window(over(Date_Of_Event,",
				"          Container_Nbr),",
				"     asc(Time_Of_event, true),",
				"     Cycle_ID = sum(Cycle_Start_Flag)) ~> window2",
				"window2 window(over(Date_Of_Event,",
				"          Container_Nbr,",
				"          Cycle_Id = Cycle_ID),",
				"     asc(Time_Of_event, true),",
				"     Cycle_Has_End = max(iif(Cycle_Status == \"END\", 1, 0)),",
				"          Cycle_Has_Correction = max(iif(Cycle_Status == \"CORRECTION\", 1, 0))) ~> window3",
				"window3 derive(Cycle_Flag = iif(\r",
				"    isNull(Cycle_ID) || Cycle_ID == 0,\r",
				"    \"Unable to Validate\",\r",
				"    iif(\r",
				"        Cycle_Has_End == 0,\r",
				"        \"Open Cycle\",\r",
				"        iif(\r",
				"            Cycle_Has_Correction == 1,\r",
				"            \"Yes\",\r",
				"            \"No\"\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 derive(Valid_Correction_Flag = iif(\r",
				"    Cycle_Flag == \"Yes\"\r",
				"    && Cycle_Status == \"CORRECTION\",\r",
				"    1,\r",
				"    0\r",
				"),",
				"          From_Block = substring(:From_Pos, 1, 3),",
				"          To_Block = substring(:To_Pos, 1, 3),",
				"          From_Pos := iif(length(split(From_Position, \"-\")[3]) == 8, substring(split(From_Position, \"-\")[3], 0, 7), split(From_Position, \"-\")[3]),",
				"          To_Pos := iif(length(split(To_Position, \"-\")[3]) == 8, substring(split(To_Position, \"-\")[3], 0, 7), split(To_Position, \"-\")[3])) ~> derivedColumn4"
			]
		}
	}
}