{
	"name": "DGT_moves_time_delta_All",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "dgt"
				},
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "filter3"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          mve_gkey as long,",
				"          Unit_Nbr as string,",
				"          Facility_Id as string,",
				"          Complex_Id as string,",
				"          Yard_Id as string,",
				"          Carrier_Visit_Key as string,",
				"          Event_Type_Id as string,",
				"          Move_Kind as string,",
				"          From_Location as string,",
				"          To_Location as string,",
				"          From_Position_Name as string,",
				"          To_Position_Name as string,",
				"          Carry_CHE_Operator_Id as string,",
				"          Fetch_CHE_Operator_Id as string,",
				"          Put_CHE_Operator_Id as string,",
				"          Fetch_CHE_Id as long,",
				"          Fetch_CHE_Kind as string,",
				"          Carry_CHE_Id as long,",
				"          Carry_CHE_Kind as string,",
				"          Put_CHE_Id as long,",
				"          Put_CHE_Kind as string,",
				"          QC_CHE_Id as long,",
				"          QC_CHE_Kind as string,",
				"          t_carry_complete as timestamp,",
				"          t_put as timestamp,",
				"          t_fetch as timestamp,",
				"          t_dispatch as timestamp,",
				"          t_discharge as timestamp,",
				"          t_carry_dispatch as timestamp,",
				"          t_carry_fetch_ready as timestamp,",
				"          t_carry_put_ready as timestamp,",
				"          dist_carry as string,",
				"          dist_start as string,",
				"          Twin_Fetch as string,",
				"          Twin_Carry as string,",
				"          Twin_Put as string,",
				"          Category_Id as string,",
				"          Freight_Kind_Id as string,",
				"          to_pos_gkey as string,",
				"          fm_pos_gkey as string,",
				"          Restow_Reason as string,",
				"          Container_Line_Id as string,",
				"          Container_Line_Role as string,",
				"          pow as string,",
				"          ufv_gkey as integer,",
				"          Berth_Id as string,",
				"          Goods_And_Ctr_Wt_Kg as integer,",
				"          active_ufv as integer,",
				"          Requires_Power_Flag as string,",
				"          OOG_Flag as string,",
				"          Shipper_Id as string,",
				"          Consignee_Id as string,",
				"          Commodity_Id as string,",
				"          ATD as timestamp,",
				"          Rehandles as string,",
				"          ATA as timestamp,",
				"          Year as integer,",
				"          Month as integer,",
				"          Week as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'silver/moves') ~> dgt",
				"source(output(",
				"          ecEventGkey as long,",
				"          yardGkey as integer,",
				"          YardID as string,",
				"          FcyID as string,",
				"          cheKind as string,",
				"          CHE_Name as string,",
				"          eventType as short,",
				"          eventSubType as short,",
				"          eventTypeDescription as string,",
				"          fromCheIdName as integer,",
				"          ToCheIdName as integer,",
				"          unit as string,",
				"          pow as string,",
				"          pool as string,",
				"          workQueue as string,",
				"          travelDistance as integer,",
				"          moveKind as string,",
				"          isTwin as boolean,",
				"          startDistance as integer,",
				"          workAssignment as long,",
				"          unitRef as string,",
				"          tran_ID as string,",
				"          locType as string,",
				"          locID as string,",
				"          locSlot as string,",
				"          opsPosID as string,",
				"          unladenLoctype as string,",
				"          unladenLocID as string,",
				"          unladenLocSlot as string,",
				"          ladenLoctype as string,",
				"          ladenLocID as string,",
				"          laden_LocSlot as string,",
				"          EcEventTime as timestamp,",
				"          cheID as integer,",
				"          Year as integer,",
				"          Month as integer,",
				"          Week as integer,",
				"          OPERATOR_ID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'silver/ecevents') ~> source1",
				"join1 derive(exec_delta_16 = iif(:exec_time > 16, true(), false()),",
				"          TimeRanking = t_put-EcEventTime,",
				"          t_execution_delta = :exec_time,",
				"          t_execution_secs = (t_carry_complete - t_fetch)/1000,",
				"          t_ladentime_secs = iif(moveKind == \"DLVR\",\r",
				"    (t_put - EcEventTime) / 1000,\r",
				"    (t_put - t_fetch) / 1000\r",
				")\r",
				",",
				"          t_unladentime_secs = \r",
				"iif(moveKind == \"DLVR\",\r",
				"    (EcEventTime-t_dispatch ) / 1000,\r",
				"    (t_fetch-t_dispatch)/1000\r",
				")\r",
				"\r",
				",",
				"          exec_time := (t_put - t_dispatch)/60000) ~> derivedColumn1",
				"dgt filter(Carry_CHE_Kind == \"SC\"\r",
				"&& (\r",
				"    Move_Kind == \"DLVR\"\r",
				"    || Move_Kind == \"RECV\"\r",
				"    || Move_Kind == \"DSCH\"\r",
				"    || Move_Kind == \"LOAD\"\r",
				")\r",
				") ~> filter1",
				"filter4 select(mapColumn(",
				"          mve_gkey,",
				"          ecEventGkey,",
				"          EcEventTime,",
				"          eventTypeDescription,",
				"          CHE_Name,",
				"          Unit_Nbr,",
				"          Facility_Id,",
				"          Yard_Id,",
				"          Event_Type_Id,",
				"          Move_Kind,",
				"          From_Location,",
				"          To_Location,",
				"          From_Position_Name,",
				"          To_Position_Name,",
				"          Carry_CHE_Kind,",
				"          t_carry_complete,",
				"          t_put,",
				"          t_fetch,",
				"          t_dispatch,",
				"          t_carry_dispatch,",
				"          t_carry_fetch_ready,",
				"          t_carry_put_ready,",
				"          Category_Id,",
				"          Freight_Kind_Id,",
				"          pow = dgt@pow,",
				"          Year = dgt@Year,",
				"          Month = dgt@Month,",
				"          Week = dgt@Week,",
				"          t_execution_delta,",
				"          t_execution_secs,",
				"          t_ladentime_secs,",
				"          t_unladentime_secs",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"filter2 alterRow(upsertIf(true())) ~> alterRow1",
				"select1 filter((t_execution_delta >= 0.0) || (t_execution_delta >= 0)) ~> filter2",
				"source1 filter(moveKind == \"DLVR\" && cheKind == \"SC\" &&  eventTypeDescription == \"LTGD\") ~> filter3",
				"filter1, derivedColumn2 join(Carry_CHE_Id == cheID",
				"     && Unit_Nbr == unit",
				"     && t_put >= EcEventTime",
				"     && t_put <= EcEventTime + minutes(15),",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> join1",
				"filter3 derive(cheID = toLong(cheID)) ~> derivedColumn2",
				"derivedColumn1 window(over(mve_gkey),",
				"     asc(TimeRanking, true),",
				"     asc(EcEventTime, true),",
				"     match_row = rowNumber()) ~> window1",
				"window1 filter(match_row == 1) ~> filter4",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'dgt',",
				"     folderPath: 'gold/execution_all',",
				"     mergeSchema: true,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['mve_gkey'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}