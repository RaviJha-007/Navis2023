{
	"name": "FLD_contecar",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "DeckingHistory"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "fld"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "AlterRow1"
				},
				{
					"name": "window1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          gkey as long,",
				"          uyv_gkey as long,",
				"          unit_id as string,",
				"          decking_type as string,",
				"          node_id as string,",
				"          yard as integer,",
				"          from_pos_loctype as string,",
				"          from_pos_locid as string,",
				"          from_pos_loc_gkey as long,",
				"          from_pos_slot as string,",
				"          from_pos_name as string,",
				"          from_pos_bin as string,",
				"          from_pos_tier as short,",
				"          to_pos_loctype as string,",
				"          to_pos_locid as string,",
				"          to_pos_loc_gkey as integer,",
				"          to_pos_slot as string,",
				"          to_pos_name as string,",
				"          to_pos_bin as string,",
				"          to_pos_tier as integer,",
				"          total_score as integer,",
				"          execution_time as integer,",
				"          phase as string,",
				"          Freight_Kind_Id as string,",
				"          time_stamp as timestamp,",
				"          Year as integer,",
				"          Month as integer,",
				"          Week as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['/bronze/deckinghistory/load','bronze/deckinghistory/archive'],",
				"     format: 'delta',",
				"     fileSystem: 'contecar',",
				"     folderPath: 'silver/deckings') ~> DeckingHistory",
				"DeckingHistory filter((decking_type == 'Bump Intruder' || decking_type == 'Vessel Discharge' || decking_type == 'Vessel Discharge - Twin' || decking_type == 'Gate Receival Assign Position') && to_pos_slot=='FLD') ~> filter1",
				"filter1 derive(Decking_Type_Actual = iif((decking_type == 'Vessel Discharge' || decking_type == 'Vessel Discharge - Twin'), 'Vessel Discharge',decking_type),",
				"          Year_Week = (Year * 100) + Week,",
				"          Year_Month = (Year * 100) + Month,",
				"          Date = toDate(time_stamp)) ~> derivedColumn1",
				"window1 alterRow(upsertIf(true())) ~> AlterRow1",
				"derivedColumn1 window(over(Date,",
				"          unit_id,",
				"          Decking_Type_Actual),",
				"     asc(time_stamp, true),",
				"     FLD_Actual_count = iif((rank() > 1), 0, 1)) ~> window1",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          gkey as long,",
				"          uyv_gkey as long,",
				"          unit_id as string,",
				"          decking_type as string,",
				"          from_pos_locid as string,",
				"          from_pos_slot as string,",
				"          from_pos_name as string,",
				"          from_pos_tier as string,",
				"          to_pos_locid as string,",
				"          to_pos_slot as string,",
				"          to_pos_name as string,",
				"          to_pos_tier as string,",
				"          total_score as integer,",
				"          execution_time as integer,",
				"          phase as string,",
				"          time_stamp as timestamp,",
				"          Year as integer,",
				"          Month as integer,",
				"          Week as integer,",
				"          Decking_Type_Actual as string,",
				"          Year_Week as integer,",
				"          Year_Month as integer,",
				"          Date as date,",
				"          fld_actual_count as integer,",
				"          freight_kind as string",
				"     ),",
				"     format: 'delta',",
				"     fileSystem: 'contecar',",
				"     folderPath: 'gold/fld',",
				"     mergeSchema: false,",
				"     autoCompact: true,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['gkey','uyv_gkey','unit_id','Date'],",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> fld"
			]
		}
	}
}