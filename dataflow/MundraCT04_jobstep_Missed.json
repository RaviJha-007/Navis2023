{
	"name": "MundraCT04_jobstep_Missed",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "window1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "AlterRow1"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ec_event_gkey as long,",
				"          yard_gkey as long,",
				"          yard_id as string,",
				"          facility_id as string,",
				"          che_kind as string,",
				"          che_name as string,",
				"          che_id as string,",
				"          event_ts as timestamp,",
				"          event_type as integer,",
				"          event_sub_type as integer,",
				"          event_type_desc as string,",
				"          from_che as string,",
				"          to_che as string,",
				"          unit_nbrs as string,",
				"          pow as string,",
				"          pool as string,",
				"          work_queue as string,",
				"          travel_distance as decimal(18,3),",
				"          move_kind as string,",
				"          is_twin as byte,",
				"          start_distance as decimal(18,3),",
				"          work_assignment_gkey as long,",
				"          unit_ref as string,",
				"          tran_id as string,",
				"          loc_type as string,",
				"          loc_id as string,",
				"          loc_slot as string,",
				"          ops_pos_id as string,",
				"          unladen_loc_type as string,",
				"          unladen_loc_id as string,",
				"          unladen_loc_slot as string,",
				"          laden_loc_type as string,",
				"          laden_loc_id as string,",
				"          laden_loc_slot as string,",
				"          last_est_move_time as string,",
				"          operator_name as string,",
				"          event_date as date,",
				"          unit_1 as string,",
				"          unit_2 as string,",
				"          unit_count as integer,",
				"          loc_block as string,",
				"          loc_bay as string,",
				"          loc_row as string,",
				"          loc_tier as short,",
				"          unladen_block as string,",
				"          unladen_bay as string,",
				"          unladen_row as string,",
				"          unladen_tier as short,",
				"          laden_block as string,",
				"          laden_bay as string,",
				"          laden_row as string,",
				"          laden_tier as short,",
				"          row_hash as long,",
				"          {_silver_loaded_at} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'mundra-ct04',",
				"     folderPath: 'silver/ecevents') ~> source1",
				"select2 filter(not(isNull(ecEventGkey)) && cheKind==\"ITV\" && (eventTypeDescription==\"AYCO\" || eventTypeDescription==\"TVDR\" || eventTypeDescription==\"AVDR\" || eventTypeDescription==\"AVCO\" || eventTypeDescription==\"TYDR\" || eventTypeDescription==\"AYDR\" ) && (moveKind==\"DSCH\"||moveKind==\"LOAD\")) ~> filter1",
				"filter1 window(over(cheID),",
				"     asc(EcEventTime, true),",
				"     asc(ecEventGkey, true),",
				"     eventTypeDescription_nxt = lead(eventTypeDescription),",
				"          eventTypeDescription_lag = lag(eventTypeDescription),",
				"          timestamp_nxt = lead(EcEventTime),",
				"          timestamp_lag = lag(EcEventTime)) ~> window1",
				"window1 derive(jobStep = iif(eventTypeDescription == 'TVDR',\r",
				"    iif(eventTypeDescription_nxt == 'AVDR' && eventTypeDescription_lag == 'AYCO', 1, 0),\r",
				"    iif(eventTypeDescription == 'TYDR',\r",
				"        iif(eventTypeDescription_nxt == 'AYDR' && eventTypeDescription_lag == 'AVCO', 1, 0),\r",
				"        toInteger(null())\r",
				"    )\r",
				"),",
				"          Types = case(\r",
				"    eventTypeDescription == 'TVDR', \r",
				"        iif((eventTypeDescription_nxt != 'AVDR' || isNull(eventTypeDescription_nxt)) && (eventTypeDescription_lag != 'AYCO' || isNull(eventTypeDescription_lag)), 'Miss at Vessel and Row',\r",
				"        iif(eventTypeDescription_nxt != 'AVDR' || isNull(eventTypeDescription_nxt), 'Load-Miss Arrive at Vessel',\r",
				"        iif(eventTypeDescription_lag != 'AYCO' || isNull(eventTypeDescription_lag), 'Load-Miss Arrive at Row', 'No Violation'))),\r",
				"    \r",
				"    eventTypeDescription == 'TYDR', \r",
				"        iif((eventTypeDescription_nxt != 'AYDR' || isNull(eventTypeDescription_nxt)) && (eventTypeDescription_lag != 'AVCO' || isNull(eventTypeDescription_lag)), 'Miss at Vessel and Row',\r",
				"        iif(eventTypeDescription_nxt != 'AYDR' || isNull(eventTypeDescription_nxt), 'DSCH-Miss Arrive at Row',\r",
				"        iif(eventTypeDescription_lag != 'AVCO' || isNull(eventTypeDescription_lag), 'DSCH-Miss Arrive at Vessel', 'No Violation'))),\r",
				"    \r",
				"    toString(null())\r",
				"),",
				"          operatorName = regexReplace(operatorName, `[^a-zA-Z0-9]`, '')) ~> derivedColumn1",
				"select1 alterRow(upsertIf(true())) ~> AlterRow1",
				"derivedColumn1 select(mapColumn(",
				"          ecEventGkey,",
				"          yardGkey,",
				"          YardID,",
				"          FcyID,",
				"          cheKind,",
				"          CHE_Name = cheName,",
				"          eventType = type,",
				"          eventSubType = subType,",
				"          eventTypeDescription,",
				"          unit,",
				"          pow = powName,",
				"          pool = poolName,",
				"          travelDistance,",
				"          moveKind,",
				"          startDistance,",
				"          EcEventTime,",
				"          cheID,",
				"          OperatorID = operatorName,",
				"          eventTypeDescription_lag,",
				"          eventTypeDescription_nxt,",
				"          timestamp_nxt,",
				"          timestamp_lag,",
				"          jobStep,",
				"          Types",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source1 select(mapColumn(",
				"          ecEventGkey = ec_event_gkey,",
				"          yardGkey = yard_gkey,",
				"          YardID = yard_id,",
				"          FcyID = facility_id,",
				"          cheKind = che_kind,",
				"          cheName = che_name,",
				"          cheID = che_id,",
				"          type = event_type,",
				"          subType = event_sub_type,",
				"          eventTypeDescription = event_type_desc,",
				"          fromCheIdName = from_che,",
				"          ToCheIdName = to_che,",
				"          unit = unit_nbrs,",
				"          powName = pow,",
				"          poolName = pool,",
				"          workQueue = work_queue,",
				"          travelDistance = travel_distance,",
				"          moveKind = move_kind,",
				"          isTwin = is_twin,",
				"          startDistance = start_distance,",
				"          unitReference = unit_ref,",
				"          tranId = tran_id,",
				"          locType = loc_type,",
				"          locId = loc_id,",
				"          locSlot = loc_slot,",
				"          opsPosId = ops_pos_id,",
				"          unladenLoctype = unladen_loc_type,",
				"          unladenLocId = unladen_loc_id,",
				"          unladenLocSlot = unladen_loc_slot,",
				"          ladenLoctype = laden_loc_type,",
				"          ladenLocId = laden_loc_id,",
				"          laden_LocSlot = laden_loc_slot,",
				"          operatorName = operator_name,",
				"          EcEventTime = event_ts",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'mundra-ct04',",
				"     folderPath: 'gold/jobstep_missed',",
				"     mergeSchema: true,",
				"     autoCompact: true,",
				"     optimizedWrite: true,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['ecEventGkey'],",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}