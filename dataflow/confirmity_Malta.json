{
	"name": "confirmity_Malta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "StackConfirmity"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "Conformity"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "window2"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "join2"
				},
				{
					"name": "window3"
				},
				{
					"name": "aggregate3"
				},
				{
					"name": "join3"
				},
				{
					"name": "select3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CONTAINERNO as string,",
				"          STACKINGFACTOR as string,",
				"          ASSIGNEDCHE as string,",
				"          BLOCKTYPE as string,",
				"          {Eq Type} as string,",
				"          {Equipment Class} as string,",
				"          CURRENTPOSITION as string,",
				"          YARDROW as string,",
				"          CAT as string,",
				"          STS as string,",
				"          SECTIONFACTOR as string,",
				"          {Outbound Carrier} as string,",
				"          {Current POD} as string,",
				"          {Gross Weight} as integer,",
				"          {Special Stow1} as string,",
				"          {Special Stow2} as string,",
				"          {Special Stow3} as string,",
				"          {Group Code} as string,",
				"          Line as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/stackconformitycsvs/load','bronze/stackconformitycsvs/archive'],",
				"     rowUrlColumn: 'FileDate',",
				"     format: 'delimited',",
				"     fileSystem: 'malta',",
				"     folderPath: 'bronze/stackconformitycsvs/load',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '',",
				"     columnNamesAsHeader: true) ~> StackConfirmity",
				"derivedColumn2 derive(Date = :created_date,",
				"          Week = iif(dayOfWeek(:created_date) == 1,  weekOfYear(:created_date) + 1, weekOfYear(:created_date)),",
				"          stacking_factor = concat( toString(Outbound_Carrier), '-', toString(POD), '-', toString(HC_STD), '-',  toString(Weight_Class)),",
				"          section_factor = concat( toString(Outbound_Carrier), '-', toString(POD), '-', toString(HC_STD)),",
				"          Section = left((Stack_Position), length(Stack_Position) - 1),",
				"          stacking_array := split(STACKINGFACTOR, '/'),",
				"          created_date := toDate(split(split(FileDate, \".\")[1],\"_\")[2], 'ddMMyyyy')) ~> derivedColumn1",
				"filter1 sort(asc(Date, true)) ~> sort1",
				"select3 filter(not(isDate(ContainerNo))) ~> filter1",
				"select2 alterRow(insertIf(true())) ~> alterRow1",
				"sort1 select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn1 window(over(Date,",
				"          Section),",
				"     asc(section_factor, true),",
				"     sectionrank = rank()) ~> window2",
				"window3 aggregate(groupBy(Date,",
				"          Section),",
				"     Section_conformity = iif(max(sectionrank) > 1, 'Mix', 'Pure')) ~> aggregate2",
				"window3, aggregate2 join(derivedColumn1@Date == aggregate2@Date",
				"     && derivedColumn1@Section == aggregate2@Section,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"window2 window(over(Date,",
				"          Stack_Position),",
				"     asc(stacking_factor, true),",
				"     stackrank = rank()) ~> window3",
				"window3 aggregate(groupBy(Date,",
				"          Stack_Position),",
				"     Stack_confirmty = iif(max(stackrank) > 1, 'Mix', 'Pure')) ~> aggregate3",
				"join2, aggregate3 join(derivedColumn1@Date == aggregate3@Date",
				"     && derivedColumn2@Stack_Position == aggregate3@Stack_Position,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          ContainerNo = container_no,",
				"          StackingFactor = stacking_factor,",
				"          AssignedCHE = Assigned_che,",
				"          BlockType = Block_type,",
				"          {Eq Type} = Eq_Type,",
				"          {Equipment Class} = Equipment_Class,",
				"          CurrentPosition = Position,",
				"          YardRow = Yard_Row,",
				"          Category,",
				"          Status,",
				"          SectionFactor = section_factor,",
				"          {Outbound Carrier} = Outbound_Carrier,",
				"          {Current POD} = POD,",
				"          {Gross Weight} = Gross_Weight,",
				"          {Special Stow1} = Special_Stow1,",
				"          {Special Stow2} = Special_Stow2,",
				"          {Special Stow3} = Special_Stow3,",
				"          {Group Code} = Group_Code,",
				"          Line,",
				"          FileDate,",
				"          Pos_WO_Tier = derivedColumn2@Stack_Position,",
				"          Date = derivedColumn1@Date,",
				"          Week,",
				"          sectionrank,",
				"          stackrank,",
				"          Date = aggregate2@Date,",
				"          Section_conformity,",
				"          Date = aggregate3@Date,",
				"          Pos_WO_Tier = aggregate3@Stack_Position,",
				"          Stack_confirmty,",
				"          Weight_Class,",
				"          HC_STD",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"StackConfirmity filter(not(startsWith(lower(CONTAINERNO), 'yard')) && not(in(['4260','4960','9400','9500','9510','22P1','22P3','42P0','42P1','42P2','42P3','45P1','45P3','49P8','55G0','55G1','5EGB','L5G0','L5G1','L5GP','L5V0','LEG0','LEG1'], {Eq Type}))) ~> filter2",
				"filter2 select(mapColumn(",
				"          container_no = CONTAINERNO,",
				"          STACKINGFACTOR,",
				"          Assigned_che = ASSIGNEDCHE,",
				"          Block_type = BLOCKTYPE,",
				"          Eq_Type = {Eq Type},",
				"          Equipment_Class = {Equipment Class},",
				"          Position = CURRENTPOSITION,",
				"          Yard_Row = YARDROW,",
				"          Category = CAT,",
				"          Status = STS,",
				"          SECTIONFACTOR,",
				"          Outbound_Carrier = {Outbound Carrier},",
				"          POD = {Current POD},",
				"          Gross_Weight = {Gross Weight},",
				"          Special_Stow1 = {Special Stow1},",
				"          Special_Stow2 = {Special Stow2},",
				"          Special_Stow3 = {Special Stow3},",
				"          Group_Code = {Group Code},",
				"          Line,",
				"          FileDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 derive(Weight_Class = iif(Gross_Weight >= 0 && Gross_Weight <= 9499, 'WC1',",
				"  iif(Gross_Weight >= 9500 && Gross_Weight <= 14499, 'WC2',",
				"    iif(Gross_Weight >= 14500 && Gross_Weight <= 19499, 'WC3',",
				"      iif(Gross_Weight >= 19500 && Gross_Weight <= 24499, 'WC4',",
				"        iif(Gross_Weight >= 24500, 'WC5',",
				"        'Unknown'))))),",
				"          Stack_Position = iif(isNull(split(Position, \".\")[2]) ,Position,split(Position, \".\")[1]),",
				"          HC_STD = iif(in(['2570','4400','4500','4510','4530','4532','7477','25G1','25S0','40HC','44U1','45G0','45G1','45G3','45GA','45GP','45R0','45R1','45R2','45R4','45R5','45U0','45U1','45U5','45V0','4EG0'], Eq_Type), 'HC',\r",
				"    iif(in(['2200','2210','2230','2231','2250','2251','2270','2276','2650','4000','4111','4200','4230','4250','4270','4300','20G0','20T0','22G','22G0','22G1','22G2','22G8','22GB','22GD','22K0','22K7','22K8','22R0','22R1','22T0','22T1','22T2','22T4','22T6','22U0','22U1','22UT','22V0','25T0','40GP','40HW','40U0','42G0','42G1','42U0','42U1','42U5','42V0','4CG1','4EG1','4EG9','4TG1','UNKN'], Eq_Type), 'STD', toString(null())))\r",
				") ~> derivedColumn2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'malta',",
				"     folderPath: 'gold/conformities',",
				"     mergeSchema: true,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Conformity"
			]
		}
	}
}