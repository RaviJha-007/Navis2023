{
	"name": "confirmity_Malta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "StackConfirmity"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "Conformity"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "window2"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "join2"
				},
				{
					"name": "window3"
				},
				{
					"name": "aggregate3"
				},
				{
					"name": "join3"
				},
				{
					"name": "select3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CONTAINERNO as string,",
				"          STACKINGFACTOR as string,",
				"          ASSIGNEDCHE as string,",
				"          BLOCKTYPE as string,",
				"          {Eq Type} as string,",
				"          {Equipment Class} as string,",
				"          CURRENTPOSITION as string,",
				"          YARDROW as string,",
				"          CAT as string,",
				"          STS as string,",
				"          SECTIONFACTOR as string,",
				"          {Outbound Carrier} as string,",
				"          {Current POD} as string,",
				"          {Gross Weight} as integer,",
				"          {Special Stow1} as string,",
				"          {Special Stow2} as string,",
				"          {Special Stow3} as string,",
				"          {Group Code} as string,",
				"          Line as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/stackconformitycsvs/load','bronze/stackconformitycsvs/archive'],",
				"     rowUrlColumn: 'FileDate',",
				"     format: 'delimited',",
				"     fileSystem: 'malta',",
				"     folderPath: 'bronze/stackconformitycsvs/load',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '',",
				"     columnNamesAsHeader: true) ~> StackConfirmity",
				"derivedColumn2 derive(Stack_Position = iif(isNull(split(Position, \".\")[2]) ,Position,split(Position, \".\")[1]),",
				"          Date = :created_date,",
				"          Week = iif(dayOfWeek(:created_date) == 1,  weekOfYear(:created_date) + 1, weekOfYear(:created_date)),",
				"          stacking_factor = concat(toString(Category), '-',  toString(Outbound_Carrier), '-', toString(POD), '-', toString(Equipment_Class), '-',  toString(Weight_Class)),",
				"          section_factor = concat(toString(Category), '-',  toString(Outbound_Carrier), '-', toString(POD), '-', toString(Equipment_Class)),",
				"          stacking_array := split(STACKINGFACTOR, '/'),",
				"          created_date := toDate(split(split(FileDate, \".\")[1],\"_\")[2], 'ddMMyyyy')) ~> derivedColumn1",
				"filter1 sort(asc(Date, true)) ~> sort1",
				"select3 filter(not(isDate(ContainerNo))) ~> filter1",
				"select2 alterRow(insertIf(true())) ~> alterRow1",
				"sort1 select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn1 window(over(Date,",
				"          YARDROW = Yard_Row),",
				"     asc(section_factor, true),",
				"     sectionrank = rank()) ~> window2",
				"window3 aggregate(groupBy(Date,",
				"          {Yard Row} = Yard_Row),",
				"     Section_conformity = iif(max(sectionrank) > 1, 'Mix', 'Pure')) ~> aggregate2",
				"window3, aggregate2 join(derivedColumn1@Date == aggregate2@Date",
				"     && Yard_Row == {Yard Row},",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"window2 window(over(Date,",
				"          Stack_Position),",
				"     asc(stacking_factor, true),",
				"     stackrank = rank()) ~> window3",
				"window3 aggregate(groupBy(Date,",
				"          Stack_Position),",
				"     Stack_confirmty = iif(max(stackrank) > 1, 'Mix', 'Pure')) ~> aggregate3",
				"join2, aggregate3 join(derivedColumn1@Date == aggregate3@Date",
				"     && derivedColumn1@Stack_Position == aggregate3@Stack_Position,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          ContainerNo = container_no,",
				"          StackingFactor = stacking_factor,",
				"          AssignedCHE = Assigned_che,",
				"          BlockType = Block_type,",
				"          {Eq Type} = Eq_Type,",
				"          {Equipment Class} = Equipment_Class,",
				"          CurrentPosition = Position,",
				"          YardRow = Yard_Row,",
				"          Category,",
				"          Status,",
				"          SectionFactor = section_factor,",
				"          {Outbound Carrier} = Outbound_Carrier,",
				"          {Current POD} = POD,",
				"          {Gross Weight} = Gross_Weight,",
				"          {Special Stow1} = Special_Stow1,",
				"          {Special Stow2} = Special_Stow2,",
				"          {Special Stow3} = Special_Stow3,",
				"          {Group Code} = Group_Code,",
				"          Line,",
				"          FileDate,",
				"          Pos_WO_Tier = derivedColumn1@Stack_Position,",
				"          Date = derivedColumn1@Date,",
				"          Week,",
				"          sectionrank,",
				"          stackrank,",
				"          Date = aggregate2@Date,",
				"          {Yard Row},",
				"          Section_conformity,",
				"          Date = aggregate3@Date,",
				"          Pos_WO_Tier = aggregate3@Stack_Position,",
				"          Stack_confirmty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"StackConfirmity filter(not(startsWith(lower(CONTAINERNO), 'yard'))) ~> filter2",
				"filter2 select(mapColumn(",
				"          container_no = CONTAINERNO,",
				"          STACKINGFACTOR,",
				"          Assigned_che = ASSIGNEDCHE,",
				"          Block_type = BLOCKTYPE,",
				"          Eq_Type = {Eq Type},",
				"          Equipment_Class = {Equipment Class},",
				"          Position = CURRENTPOSITION,",
				"          Yard_Row = YARDROW,",
				"          Category = CAT,",
				"          Status = STS,",
				"          SECTIONFACTOR,",
				"          Outbound_Carrier = {Outbound Carrier},",
				"          POD = {Current POD},",
				"          Gross_Weight = {Gross Weight},",
				"          Special_Stow1 = {Special Stow1},",
				"          Special_Stow2 = {Special Stow2},",
				"          Special_Stow3 = {Special Stow3},",
				"          Group_Code = {Group Code},",
				"          Line,",
				"          FileDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 derive(Weight_Class = iif(Gross_Weight >= 0 && Gross_Weight <= 9499, 'Class 1',\r",
				"  iif(Gross_Weight >= 9500 && Gross_Weight <= 14499, 'Class 2',\r",
				"    iif(Gross_Weight >= 14500 && Gross_Weight <= 19499, 'Class 3',\r",
				"      iif(Gross_Weight >= 19500 && Gross_Weight <= 24499, 'Class 4',\r",
				"        iif(Gross_Weight >= 24500, 'Class 5',\r",
				"        'Unknown')))))\r",
				") ~> derivedColumn2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'malta',",
				"     folderPath: 'gold/conformities',",
				"     mergeSchema: true,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Conformity"
			]
		}
	}
}