{
	"name": "confirmity_csv_APMT_Elz",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "StackConfirmity"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "Conformity"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "window1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "window2"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "join2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {[ContainerNo]} as string,",
				"          {[StackingFactor]} as string,",
				"          {[AssignedCHE]} as string,",
				"          {[BlockType]} as string,",
				"          {[Eq Type]} as string,",
				"          {[Equipment Class]} as string,",
				"          {[YardRow]} as string,",
				"          {[Cat]} as string,",
				"          {[Sts]} as string,",
				"          {[SectionFactor]} as string,",
				"          {[Outbound Carrier]} as string,",
				"          {[Current POD]} as string,",
				"          {[Line]} as string,",
				"          {[CurrentPosition]} as string,",
				"          {[SumGross_Weight]} as double,",
				"          {[Special Stow1]} as string,",
				"          {[Special Stow2]} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/stackconformitycsvs/load1','bronze/stackconformitycsvs/archive1'],",
				"     rowUrlColumn: 'FileDate',",
				"     format: 'delimited',",
				"     fileSystem: 'apmt-elz',",
				"     folderPath: 'bronze/stackconformitycsvs/load1',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '',",
				"     columnNamesAsHeader: true) ~> StackConfirmity",
				"select3 derive(Pos_WO_Tier = (iif(isInteger(right(CurrentPosition, 1)), left(CurrentPosition, length(CurrentPosition) - 2), CurrentPosition)),",
				"          Date = :created_date,",
				"          Week = iif(dayOfWeek(:created_date) == 1,  weekOfYear(:created_date) + 1, weekOfYear(:created_date)),",
				"          StackingFactor_der = iif(     Sts == 'FCL',     Outbound_Carrier + '/' + Current_POD + '/' + iifNull(Special_Stow1, '') + '/' + iifNull(Special_Stow2, '') + '/' + Equipment_Class,     iif(         Sts == 'MTY',         Equipment_Class + '/' + Line,         toString(null())     ) ),",
				"          SectionFactor_der = iif(    Sts == 'FCL',    Outbound_Carrier + '/' + Current_POD + '/' + Sts,    iif(        Sts == 'MTY',        Equipment_Class + '/' + Line,        toString(null())    )),",
				"          created_date := toDate(split(split(FileDate, \"_\")[2],\".\")[1], 'ddMMyy')) ~> derivedColumn1",
				"derivedColumn1 window(over(Date,",
				"          Pos_WO_Tier),",
				"     asc(StackingFactor, true),",
				"     stackrank = rank()) ~> window1",
				"window1 aggregate(groupBy(Date,",
				"          Pos_WO_Tier),",
				"     Stack_confirmty = iif(max(stackrank) > 1, 'Mix', 'Pure')) ~> aggregate1",
				"window1, aggregate1 join(derivedColumn1@Date == aggregate1@Date",
				"     && derivedColumn1@Pos_WO_Tier == aggregate1@Pos_WO_Tier,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"filter1 select(mapColumn(",
				"          {Container No} = ContainerNo,",
				"          {Stacking Factor} = StackingFactor,",
				"          Eq_Type,",
				"          BlockType,",
				"          {Current position} = CurrentPosition,",
				"          {Yard Row} = select3@YardRow,",
				"          Cat,",
				"          Sts,",
				"          {Section Factor} = SectionFactor,",
				"          Pos_WO_Tier = derivedColumn1@Pos_WO_Tier,",
				"          Date = derivedColumn1@Date,",
				"          Week,",
				"          StackingFactor_der,",
				"          SectionFactor_der,",
				"          Stack_confirmty,",
				"          Section_conformity,",
				"          Line",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sort(asc(Date, true),",
				"     asc({Container No}, true)) ~> sort1",
				"join2 filter(not(isDate(ContainerNo)) && not(isNull(ContainerNo)) && ContainerNo != '') ~> filter1",
				"select2 alterRow(insertIf(true())) ~> alterRow1",
				"sort1 select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn1 window(over(Date,",
				"          YardRow),",
				"     asc(SectionFactor, true),",
				"     sectionrank = rank()) ~> window2",
				"window2 aggregate(groupBy(Date,",
				"          YardRow),",
				"     Section_conformity = iif(max(sectionrank) > 1, 'Mix', 'Pure')) ~> aggregate2",
				"aggregate2, join1 join(aggregate2@Date == aggregate1@Date",
				"     && aggregate2@YardRow == select3@YardRow,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"StackConfirmity select(mapColumn(",
				"          ContainerNo = {[ContainerNo]},",
				"          StackingFactor = {[StackingFactor]},",
				"          AssignedCHE = {[AssignedCHE]},",
				"          BlockType = {[BlockType]},",
				"          Eq_Type = {[Eq Type]},",
				"          Equipment_Class = {[Equipment Class]},",
				"          YardRow = {[YardRow]},",
				"          Cat = {[Cat]},",
				"          Sts = {[Sts]},",
				"          SectionFactor = {[SectionFactor]},",
				"          Outbound_Carrier = {[Outbound Carrier]},",
				"          Current_POD = {[Current POD]},",
				"          Line = {[Line]},",
				"          CurrentPosition = {[CurrentPosition]},",
				"          SumGross_Weight = {[SumGross_Weight]},",
				"          Special_Stow1 = {[Special Stow1]},",
				"          Special_Stow2 = {[Special Stow2]},",
				"          FileDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'apmt-elz',",
				"     folderPath: 'gold/conformities_new',",
				"     mergeSchema: true,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Container_No,",
				"          Stacking_Factor,",
				"          Eq_Type,",
				"          BlockType,",
				"          Current_position,",
				"          Yard_Row,",
				"          Cat,",
				"          Sts,",
				"          Section_Factor,",
				"          Pos_WO_Tier,",
				"          Date,",
				"          Week,",
				"          StackingFactor_der,",
				"          SectionFactor_der,",
				"          Stack_confirmty,",
				"          Section_conformity,",
				"          Line",
				"     )) ~> Conformity"
			]
		}
	}
}