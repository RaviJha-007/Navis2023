{
	"name": "confirmity_manual_Yilport",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "linkedService2",
						"type": "LinkedServiceReference"
					},
					"name": "sc"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "linkedService1",
						"type": "LinkedServiceReference"
					},
					"name": "Conformity"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "window2"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "join2"
				},
				{
					"name": "window3"
				},
				{
					"name": "aggregate3"
				},
				{
					"name": "join3"
				},
				{
					"name": "select3"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "filter3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Container No.} as string,",
				"          {Stacking Factor} as string,",
				"          {Assigned CHE} as string,",
				"          {Blk Typ} as string,",
				"          Type as string,",
				"          {Current Position} as string,",
				"          {Impact Row} as string,",
				"          Cat as string,",
				"          Sts as string,",
				"          {Section Factor} as string,",
				"          Block as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: true,",
				"     moveFiles: ['bronze/stackconformity/load','bronze/stackconformity/archive'],",
				"     rowUrlColumn: 'FileDate',",
				"     format: 'delimited',",
				"     fileSystem: 'yilport',",
				"     folderPath: 'bronze/stackconformity/load',",
				"     columnDelimiter: '\\t',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '',",
				"     columnNamesAsHeader: true) ~> sc",
				"sc derive(Pos_WO_Tier = (iif(isInteger(right({Current Position}, 1)), left({Current Position}, length({Current Position}) - 1), {Current Position})),",
				"          Date = :created_date,",
				"          Week = iif(dayOfWeek(:created_date) == 1,  weekOfYear(:created_date) + 1, weekOfYear(:created_date)),",
				"          stacking_array := split({Stacking Factor}, '/'),",
				"          created_date := toDate(split(split(FileDate, \".\")[1],\"/\")[5], 'yyyyMMdd')) ~> derivedColumn1",
				"filter1 sort(asc(Date, true),",
				"     asc({Container No}, true)) ~> sort1",
				"select3 filter(not(isDate({Container No})) && not(isNull({Container No})) && {Container No} != '') ~> filter1",
				"select2 alterRow(insertIf(true())) ~> alterRow1",
				"sort1 select(mapColumn(",
				"          each(match(true()),",
				"               regexReplace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"filter2 window(over(Date,",
				"          Yard_Row),",
				"     asc({Section Factor}, true),",
				"     sectionrank = denseRank()) ~> window2",
				"window2 aggregate(groupBy(Date,",
				"          Yard_Row),",
				"     Section_conformity = iif(max(sectionrank) > 1, 'Mix', 'Pure')\r",
				") ~> aggregate2",
				"derivedColumn3, aggregate2 join(derivedColumn1@Date == aggregate2@Date",
				"     && derivedColumn2@Yard_Row == aggregate2@Yard_Row,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"filter3 window(over(Date,",
				"          Pos_WO_Tier),",
				"     asc({Stacking Factor}, true),",
				"     stackrank = denseRank()) ~> window3",
				"window3 aggregate(groupBy(Date,",
				"          Pos_WO_Tier),",
				"     Stack_confirmty = iif(max(stackrank) > 1, 'Mix', 'Pure')) ~> aggregate3",
				"join2, aggregate3 join(derivedColumn1@Date == aggregate3@Date",
				"     && derivedColumn1@Pos_WO_Tier == aggregate3@Pos_WO_Tier,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          {Container No} = {Container No.},",
				"          {Stacking Factor},",
				"          {Assigned CHE},",
				"          {Blk Typ},",
				"          Type,",
				"          {Current Position},",
				"          {Impact Row},",
				"          Cat,",
				"          Sts,",
				"          {Section Factor},",
				"          Block,",
				"          FileDate,",
				"          Pos_WO_Tier = derivedColumn1@Pos_WO_Tier,",
				"          Date = derivedColumn1@Date,",
				"          Week,",
				"          Yard_Row = derivedColumn2@Yard_Row,",
				"          Valid_Section,",
				"          Valid_Stack,",
				"          Section_conformity,",
				"          Stack_confirmty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn1 derive(Yard_Row = iif(     \r",
				"    isNull(Pos_WO_Tier) || Pos_WO_Tier == '',     \r",
				"    '',     \r",
				"    iif(         \r",
				"        Pos_WO_Tier == 'WALL' ||         \r",
				"        Pos_WO_Tier == 'OOG' ||         \r",
				"        left(Pos_WO_Tier,4) == 'CFS',         \r",
				"        Pos_WO_Tier,         \r",
				"        iif(             \r",
				"            length(Pos_WO_Tier) > 2,             \r",
				"            left(Pos_WO_Tier,length(Pos_WO_Tier)-1),             \r",
				"            ''         \r",
				"            )     \r",
				"            ) \r",
				"            )) ~> derivedColumn2",
				"derivedColumn2 derive(Valid_Section = iif(\r",
				"    isNull({Current Position}) || {Current Position} == '' ||\r",
				"    isNull({Section Factor}) || {Section Factor} == '' ||\r",
				"    isNull(Yard_Row) || Yard_Row == '' ||\r",
				"    Yard_Row == Pos_WO_Tier ||\r",
				"    left({Current Position},3) == 'CFS' ||\r",
				"    left({Current Position},5) == 'BERTH',\r",
				"    'N/A',\r",
				"    'VALID'\r",
				"),",
				"          Valid_Stack = iif(\r",
				"    isNull({Current Position}) || {Current Position} == '' ||\r",
				"    isNull(Pos_WO_Tier) || Pos_WO_Tier == '' ||\r",
				"    isNull({Stacking Factor}) || {Stacking Factor} == '' ||\r",
				"    {Current Position} == Pos_WO_Tier ||\r",
				"    left({Current Position},3) == 'CFS' ||\r",
				"    left({Current Position},5) == 'BERTH',\r",
				"    'N/A',\r",
				"    'VALID'\r",
				")) ~> derivedColumn3",
				"derivedColumn3 filter(Valid_Section==\"VALID\") ~> filter2",
				"derivedColumn3 filter(Valid_Stack==\"VALID\") ~> filter3",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'yilport',",
				"     folderPath: 'gold/manual_conformities',",
				"     mergeSchema: true,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Conformity"
			]
		}
	}
}