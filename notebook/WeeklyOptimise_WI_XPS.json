				"cell_type": "code",
				"source": [
					"from datetime import datetime\n",
					"\n",
					"storage_account = \"navispowerbidatastorage2\"\n",
					"silver_path = f\"abfss://workinstruction@{storage_account}.dfs.core.windows.net/silver_xps/\"\n",
					"\n",
					"print(f\"🔧 Weekly Maintenance — {datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n",
					"print(\"=\" * 60)\n",
					"\n",
					"# Check file count before\n",
					"before = spark.sql(f\"DESCRIBE DETAIL delta.`{silver_path}`\").collect()[0][\"numFiles\"]\n",
					"\n",
					"# Optimize entire table (all partitions)\n",
					"spark.sql(f\"OPTIMIZE delta.`{silver_path}`\")\n",
					"\n",
					"# Check file count after\n",
					"after = spark.sql(f\"DESCRIBE DETAIL delta.`{silver_path}`\").collect()[0][\"numFiles\"]\n",
					"\n",
					"print(f\"  ✅ silver_xps (all partitions): {before} files → {after} files\")\n",
					"\n",
					"print(\"=\" * 60)\n",
					"print(\"✅ Weekly maintenance complete!\")\n",
					""
				],
				"execution_count": 1
			}
		]
	}
